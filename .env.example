# --- Odoo connection (one Odoo user + API key; read-only use) ---
ODOO_URL=https://evertech.odoo.com
ODOO_DB=evertech
ODOO_LOGIN=dashboard@evertech.example
ODOO_API_KEY=

# --- Dashboard access ---
# Personal sign-in with an emailed 6-digit code: list who may sign in (emails, or @domain for everyone at that domain).
# When set, the shared password below is not used.
DASHBOARD_USERS=                        # e.g. ebin@evertechme.com, sara@evertechme.com   or   @evertechme.com
OTP_MINUTES=10                          # how long a code is valid
# Sending the codes from Microsoft 365 — choose ONE:
#  a) Microsoft Graph (recommended; keeps working after Microsoft retires password SMTP): an Entra app registration with
#     the Mail.Send *application* permission (admin consent). MAIL_FROM is the mailbox the codes come from.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MAIL_FROM=                              # e.g. dashboard@evertechme.com
#  b) SMTP: the mailbox's login; "Authenticated SMTP" must be on for that mailbox in the Microsoft 365 admin centre
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=dashboard@evertechme.com
# SMTP_PASS=
DASHBOARD_PASSWORD=change-me            # shared password, only used when DASHBOARD_USERS is empty
SESSION_SECRET=                         # long random string, e.g. `openssl rand -hex 32`
TV_TOKEN=                               # optional: open /tv/<TV_TOKEN> on a meeting-room screen (read-only, auto-refresh)
COOKIE_SECURE=1                         # 1 when served over HTTPS
TRUST_PROXY=                            # 1 when behind a host proxy (Render, Railway, Azure, nginx); leave empty if the app faces the internet directly

# --- Options ---
PORT=3000
CACHE_MINUTES=10                        # how often data is re-read from Odoo (the Refresh button forces it)
DASHBOARD_TZ=Asia/Dubai                 # what "today" means for periods and AMC expiry
AMC_KEYWORD=AMC                         # an order is an AMC if a tag, product or line description contains this
AMC_TERM_MONTHS=12
AMC_EXPIRY_FROM=created                 # created = order creation date (default) | confirmed = order confirmation date
# Licence renewals (Microsoft, Fortinet…): a line counts when it names a vendor keyword AND looks like a licence (licence, subscription, 1 Year, SKU -12…)
# LICENSE_VENDORS=Microsoft=microsoft,m365,office 365,o365,azure,exchange online,windows server,dynamics 365; Fortinet=fortinet,forti
LICENSE_TERM_MONTHS=12                  # used when the product doesn't say ("1 Year", "36 Months", "annual", Fortinet SKU "-36")
LICENSE_EXPIRY_FROM=confirmed           # confirmed = order confirmation date (default) | created = order creation date
TO_INVOICE_FROM=                        # "To invoice" counts orders dated from this day (default: 1 Jan of the current year)
# Statement of account texts (all can also be edited on the statement before printing)
# SOA_COMPANY=Evertech IT Infrastructure LLC   # default: the Odoo company of the invoices
# SOA_GREETING=Dear Accounts Payable Team,
# SOA_CLOSING=Kindly settle the amount and share the remittance advice
# SOA_QUERY=Should you have any query about this statement, please contact me directly.
# SOA_SIGNATURE=Account Manager
# SOA_EMAIL=accounts@evertechme.com             # optional line under the signature
# SOA_BANK=Account Title: Evertech IT Infrastructure LLC|Bank: Abu Dhabi Commercial Bank|Branch Address: Al Rigga, Dubai, U.A.E|Account No: 13275719920001|IBAN: AE970030013275719920001|Swift Code: ADCBAEAA|Currency: AED
# DEMO=1                                # show sample data instead of Odoo
