# --- Odoo connection (one Odoo user + API key; read-only use) ---
ODOO_URL=https://evertech.odoo.com
ODOO_DB=evertech
ODOO_LOGIN=dashboard@evertech.example
ODOO_API_KEY=

# --- Dashboard access ---
DASHBOARD_PASSWORD=change-me            # staff sign in with this
SESSION_SECRET=                         # long random string, e.g. `openssl rand -hex 32`
TV_TOKEN=                               # optional: open /tv/<TV_TOKEN> on a meeting-room screen (read-only, auto-refresh)
COOKIE_SECURE=1                         # 1 when served over HTTPS
TRUST_PROXY=                            # 1 when behind a host proxy (Render, Railway, Azure, nginx); leave empty if the app faces the internet directly

# --- Options ---
PORT=3000
CACHE_MINUTES=10                        # how often data is re-read from Odoo (the Refresh button forces it)
DASHBOARD_TZ=Asia/Dubai                 # what "today" means for periods and AMC expiry
AMC_KEYWORD=AMC                         # an order is an AMC if a tag, product or line description contains this
AMC_TERM_MONTHS=12
AMC_EXPIRY_FROM=created                 # created = order creation date (default) | confirmed = order confirmation date
# Licence renewals (Microsoft, Fortinet…): a line counts when it names a vendor keyword AND looks like a licence (licence, subscription, 1 Year, SKU -12…)
# LICENSE_VENDORS=Microsoft=microsoft,m365,office 365,o365,azure,exchange online,windows server,dynamics 365; Fortinet=fortinet,forti
LICENSE_TERM_MONTHS=12                  # used when the product doesn't say ("1 Year", "36 Months", "annual", Fortinet SKU "-36")
LICENSE_EXPIRY_FROM=confirmed           # confirmed = order confirmation date (default) | created = order creation date
# DEMO=1                                # show sample data instead of Odoo
